index 63f84a8..444ddab 100644
--- a/FEXCore/Source/Utils/AllocatorHooks.cpp
+++ b/FEXCore/Source/Utils/AllocatorHooks.cpp
@@ -1,3 +1,5 @@
+#include <stdlib.h>
+#include <unistd.h>
 // SPDX-License-Identifier: MIT
 #include <FEXCore/Utils/PrctlUtils.h>
 
@@ -230,7 +232,15 @@ void* memalign(size_t align, size_t s) {
   return ::memalign(align, s);
 }
 void* valloc(size_t size) {
-  return ::valloc(size);
+  #ifdef __ANDROID__
+    void* ptr = nullptr;
+    const long page = ::sysconf(_SC_PAGESIZE);
+    if (page <= 0) return nullptr;
+    return ::posix_memalign(&ptr, static_cast<size_t>(page), size)
+        == 0 ? ptr : nullptr;
+#else
+    return ::valloc(size);
+#endif
 }
 int posix_memalign(void** r, size_t a, size_t s) {
   return ::posix_memalign(r, a, s);
@@ -245,7 +255,19 @@ size_t malloc_usable_size(void* ptr) {
   return ::malloc_usable_size(ptr);
 }
 void* aligned_alloc(size_t a, size_t s) {
-  return ::aligned_alloc(a, s);
+  #ifdef __ANDROID__
+    if (!a || (a & (a - 1)) || s % a != 0)
+        return nullptr;
+
+    const size_t alignment =
+        a < sizeof(void*) ? sizeof(void*) : a;
+
+    void* ptr = nullptr;
+    return ::posix_memalign(&ptr, alignment, s)
+        == 0 ? ptr : nullptr;
+#else
+    return ::aligned_alloc(a, s);
+#endif
 }
 void aligned_free(void* ptr) {
   return ::free(ptr);
